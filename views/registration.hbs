<div id="signup">

  {{{card}}}

  {{#if useBackendOnlyCaptcha}}
    {{> captcha-backend-only captchaQuestion=captchaQuestion captchaToken=captchaToken captchaError=captchaError}}
  {{else}}
    {{> captcha captchaQuestion=captchaQuestion captchaToken=captchaToken}}
  {{/if}}

  {{> js_setup nodes=nodes}}
  {{#if extraPartial }}
    {{> (extraPartial) }}
  {{/if}}
</div>
